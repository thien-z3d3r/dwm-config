{
	"layer": "top",
	"modules-left": ["custom/powermenu", "river/tags", "temperature", "custom/screen-off"],
	"modules-center": ["river/window"],
	"modules-right": ["battery", "custom/battery-mode", "custom/mode-custom", "backlight", "pulseaudio", "custom/mic","custom/cpu","custom/clock", "tray"],
	"pulseaudio": {
		"tooltip": false,
		"scroll-step": 5,
		"format": "{icon}  {volume}%",
		"format-muted": "󰝟  0%",
		"on-click":"amixer -D pulse Master 1+ toggle",
		"scroll-step": 5,
		"format-icons": {
			"default": ["", "󰖀", "󰕾"]
		}
	},
	"custom/powermenu": {
		"format": "",
		"interval": "once",
		/*"exec": "checkupdates | wc -l",*/
		"on-click": "~/.config/waybar/modules/powermenu.sh",
		"tooltip": false,
		"signal": 8
	},


	"custom/spotify": {
		"format": "{icon}  {}",
		"format-icons": ["", ""],
		"return-type": "json",
		"max-length": 10,
		"exec": "spotifatius monitor",
		"on-click-right": "spotifatius toggle-liked",
	},

	"river/tags": {
		"tag-labels":[
			"1",
			"2",
			"3",
			"4",
			"5",
			"6",
			"7",
		],
		"disable-click": false,
		"num-tags": 7
	},
	"temperature": {
		"hwmon-path": "/sys/class/hwmon/hwmon1/temp1_input",
		"input-filename": "temp1_input",
		"format": "{temperatureC}°C ",
		"on-click": ""
	},
	"river/window": {
		"format": "  {}",
		"max-length": 90
	},
	"backlight": {
		"device": "nvidia_0",
		"format": "{}% {icon}",
		"format-icons": ["", ""],
		"interval": 1,
		"on-click": ""
	},
	"custom/mode-custom": {
		"format": "{}",
		"return-type": "json",
		"interval": 2,
		"exec": "~/.config/waybar/modules/powersave.sh status",
		"on-click": "~/.config/waybar/modules/powersave.sh toggle",
		"on-click-right": "~/.config/waybar/modules/powersave.sh menu",
		"signal": 10
	},
	"battery": {
		"states": {
			"good": 100,
			"warning": 30,
			"critical": 20
		},
		"format": "{icon}  {capacity}%",
		"format-charging": "{icon}   {capacity}%",
		"format-plugged": "{icon}   {capacity}%",
		"format-icons": ["", "", "", "", ""],
		"on-click": "~/.config/waybar/modules/battery-mode.sh menu",
		"on-click-right": "~/.config/waybar/modules/battery-mode.sh next",
		"on-scroll-up": "~/.config/waybar/modules/battery-mode.sh next",
		"on-scroll-down": "~/.config/waybar/modules/battery-mode.sh prev"
	},
	"custom/battery-mode": {
		"format": "{}",
		"return-type": "json",
		"interval": 2,
		"exec": "~/.config/waybar/modules/battery-mode.sh status",
		"on-click": "~/.config/waybar/modules/battery-mode.sh menu",
		"on-click-right": "~/.config/waybar/modules/battery-mode.sh next",
		"on-scroll-up": "~/.config/waybar/modules/battery-mode.sh next",
		"on-scroll-down": "~/.config/waybar/modules/battery-mode.sh prev",
		"signal": 9
	},
	"tray":{
		"icon-size":18,
		"show-passive-items":true,
		"spacing": 10,
		"reverse-direction": true
	},
	"custom/clock": {
		"interval": 1,
		"return-type": "string",
		"exec": "~/.config/waybar/modules/datetime.sh",
		"tooltip": false,
		"on-click": ""
	},
	"custom/cpu": {
		"interval": 1,
		"return-type": "string",
		"exec": "~/.config/waybar/modules/cpu.sh",
		"tooltip": false,
		"on-click": ""
	},
	"custom/screen-off": {
		"format": " 󰌾 ",
		"tooltip": true,
		"tooltip-format": "Left click: Screen off (wake on key/mouse)\nRight click: Lock screen",
		"on-click": "~/.config/waybar/modules/screen-off.sh",
		"on-click-right": "~/.config/waybar/modules/screen-off.sh --lock"
	}
}
